<?xml version='1.0' encoding='windows-1252'?>
<!--
  WiX v3 source for the Windows installer. Build with:
    cargo install cargo-wix
    cargo wix -p screenshareapp \
      -C -dAvcodecDll=avcodec-62.dll \
      -C -dAvutilDll=avutil-60.dll \
      -C -dSwresampleDll=swresample-6.dll \
      -C -dSwscaleDll=swscale-9.dll \
      -C -dAvformatDll=avformat-62.dll \
      -C -dAvfilterDll=avfilter-11.dll \
      -C -dAvdeviceDll=avdevice-62.dll
  after copying those FFmpeg DLLs next to the release exe (see .github/workflows/ci.yml).
  Without the -d flags the installer omits them, and the exe will not start
  unless it was built without the default "hw" feature (software video only).
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='screenshare'
        UpgradeCode='E1C2C504-E09A-4549-86E6-E8A491647EFF'
        Manufacturer='screenshare contributors'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Peer-to-peer screen sharing with audio'
            Manufacturer='screenshare contributors'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='screenshare Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='screenshare'>
                    <Component Id='binary0' Guid='*'>
                        <File
                            Id='exe0'
                            Name='screenshareapp.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\screenshareapp.exe'
                            KeyPath='yes'/>
                    </Component>
                    <?ifdef AvcodecDll ?>
                    <!-- FFmpeg LGPL shared runtime; BtbN avcodec depends on swresample+avutil. -->
                    <Component Id='avcodec' Guid='*'>
                        <File Id='avcodec' Name='$(var.AvcodecDll)' DiskId='1'
                            Source='$(var.CargoTargetBinDir)\$(var.AvcodecDll)' KeyPath='yes'/>
                    </Component>
                    <Component Id='avutil' Guid='*'>
                        <File Id='avutil' Name='$(var.AvutilDll)' DiskId='1'
                            Source='$(var.CargoTargetBinDir)\$(var.AvutilDll)' KeyPath='yes'/>
                    </Component>
                    <Component Id='swresample' Guid='*'>
                        <File Id='swresample' Name='$(var.SwresampleDll)' DiskId='1'
                            Source='$(var.CargoTargetBinDir)\$(var.SwresampleDll)' KeyPath='yes'/>
                    </Component>
                    <Component Id='swscale' Guid='*'>
                        <File Id='swscale' Name='$(var.SwscaleDll)' DiskId='1'
                            Source='$(var.CargoTargetBinDir)\$(var.SwscaleDll)' KeyPath='yes'/>
                    </Component>
                    <Component Id='avformat' Guid='*'>
                        <File Id='avformat' Name='$(var.AvformatDll)' DiskId='1'
                            Source='$(var.CargoTargetBinDir)\$(var.AvformatDll)' KeyPath='yes'/>
                    </Component>
                    <Component Id='avfilter' Guid='*'>
                        <File Id='avfilter' Name='$(var.AvfilterDll)' DiskId='1'
                            Source='$(var.CargoTargetBinDir)\$(var.AvfilterDll)' KeyPath='yes'/>
                    </Component>
                    <Component Id='avdevice' Guid='*'>
                        <File Id='avdevice' Name='$(var.AvdeviceDll)' DiskId='1'
                            Source='$(var.CargoTargetBinDir)\$(var.AvdeviceDll)' KeyPath='yes'/>
                    </Component>
                    <?endif ?>
                </Directory>
            </Directory>
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='screenshare'>
                    <Component Id='StartMenuShortcut' Guid='522F09F9-BE04-4F51-AEEC-0214B93287BD'>
                        <Shortcut
                            Id='AppShortcut'
                            Name='screenshare'
                            Description='Peer-to-peer screen sharing'
                            Target='[APPLICATIONFOLDER]screenshareapp.exe'
                            WorkingDirectory='APPLICATIONFOLDER'/>
                        <RemoveFolder Id='CleanUpShortCut' On='uninstall'/>
                        <RegistryValue
                            Root='HKCU'
                            Key='Software\screenshare\screenshare'
                            Name='installed'
                            Type='integer'
                            Value='1'
                            KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs screenshare.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='binary0'/>
            <?ifdef AvcodecDll ?>
            <ComponentRef Id='avcodec'/>
            <ComponentRef Id='avutil'/>
            <ComponentRef Id='swresample'/>
            <ComponentRef Id='swscale'/>
            <ComponentRef Id='avformat'/>
            <ComponentRef Id='avfilter'/>
            <ComponentRef Id='avdevice'/>
            <?endif ?>
            <ComponentRef Id='StartMenuShortcut'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <UI>
            <UIRef Id='WixUI_InstallDir'/>
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='InstallDirDlg' Order='99'>1</Publish>
            <Publish Dialog='InstallDirDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>
        <Property Id='WIXUI_INSTALLDIR' Value='APPLICATIONFOLDER'/>
    </Product>
</Wix>
